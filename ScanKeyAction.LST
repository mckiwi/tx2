 143          void dataout(char keyout)
 144          {
 145   1        U8 key_Number;//,i;
 146   1        key_Number = keyout;    //按鍵資料由LED輸出
 147   1        NJWDelay(150);
 148   1        while(!(COL0 & COL1 & COL2 & COL3))//若COL0~3≠1111未放開按鍵
 149   1          NJWDelay(150);
 150   1        switch(key_Number)
 151   1        {
 152   2          case(0):{INPUT_Function = KTV; INPUT_Action(); break;}
 153   2          case(1):{INPUT_Function = DVD; INPUT_Action(); break;}
 154   2          case(2):{INPUT_Function = AUX; INPUT_Action(); break;}
 155   2          case(3):{INPUT_Function = BT; INPUT_Action(); break;}
 156   2          case(4):{INPUT_Function = COAX; INPUT_Action(); break;} 
 157   2          case(5):{INPUT_Function = OPT1; INPUT_Action(); break;}
 158   2          case(6):{INPUT_Function = OPT2; INPUT_Action(); break;}       
 159   2          case(7):{LOUD_Function++; Loud_Action(); break;}
 160   2          case(8):{//SBUF=TABLE[7];   -->//SPA
 161   3                //SPA
 162   3                if(SP_Function == AB_OFF) SP_Function = A_ON;
 163   3                else if(SP_Function == A_ON) SP_Function = AB_OFF;
 164   3                  else if(SP_Function == B_ON) SP_Function = AB_ON;
 165   3                    else if(SP_Function == AB_ON) SP_Function = B_ON;
 166   3                SP_Action();      
 167   3                break;
 168   3              }
 169   2          case(9):{//SBUF=TABLE[6];   -->//SPB
 170   3                //SPB
 171   3                if(SP_Function == AB_OFF) SP_Function = B_ON;
 172   3                else if(SP_Function == A_ON) SP_Function = AB_ON;
 173   3                  else if(SP_Function == B_ON) SP_Function = AB_OFF;
 174   3                    else if(SP_Function == AB_ON) SP_Function = A_ON;
 175   3                SP_Action();      
 176   3                break;
 177   3              }
 178   2          case(10):{STECHO_Function++; STECHO_Action(); break;}
 179   2          case(11):{ECHO_Function++; ECHO_Action(); break;}
