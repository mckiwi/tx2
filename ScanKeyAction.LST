  20          void Sdataout(char Skeyout)
  21          {
  22   1        U8 Skey_Number;//,i;
  23   1        Skey_Number = Skeyout;    //按鍵資料由LED輸出
  24   1        POWER_GreenLED_ON;
  25   1        //*** PCLK1_Action();
  26   1        PCLK_Action(IOEXP_SRC);   //~DA,240808
  27   1        PCLK_Action(IOEXP_FUNC);  //~DA,240808,added!
  28   1      
  29   1        NJWDelay(150);
  30   1        if ((Skeyout != 6) && (Skeyout != 7))         //:Dennis,A
  31   1            while(!(COL0 & COL1 & COL2 & COL3))//若COL0~3≠1111未放開按鍵
  32   1        NJWDelay(150);
  33   1        switch(Skey_Number)
  34   1        {
  35   2          case(0):{Limit_VR_Set(); break;}
  36   2          case(1):{Set_Power_ON_VR_Preset(); break;}
  37   2          case(2):{Restore_Preset_Function(); break;}
  38   2          case(3):{Cancel_Remote_Key(); break;}
  39   2          case(4):{Limit_VR_Set_Action(); break;}
  40   2          case(5):{Set_Power_ON_VR_Preset_Action(); break;}
  41   2          //:Dennis,A
  42   2          case(6):
  43   2            { //:Dennis, set Preset directPower, not allow from directPowerON
  44   3              if (fromSTB_SW == 1)
  45   3                DIRECTPower_Preset_Function(); 
  46   3              break;
  47   3            }                           
  48   2          case(7):
  49   2            { //:Dennis, set Preset Input source, not allow from directPowerON
  50   3              if (fromSTB_SW == 1)
  51   3                INPUT_Preset_Function(preSet_INPUT_Function); 
  52   3              break;
  53   3            } 
  54   2          default:{break;}
  55   2        }
