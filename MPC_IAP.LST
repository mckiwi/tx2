 101          ///////////////////////////////////////////////////
 102          //
 103          //      Function:Set_IAPLB(XX)
 104          //  Set IAP start address is 0xXX00 to ISP start address
 105          //  Ex:8752 default ISP address : 0x1C00 ~ 0x1FFF(1K)
 106          //     Set IAPLB to 0x10
 107          //     Then IAP address : 0x1000 ~ 0x1BFF(2K)
 108          //
 109          ///////////////////////////////////////////////////
 110          #if (ICTYPE==MPC8752)||(ICTYPE==MPC87x051)
 111          void Set_IAPLB(unsigned char IAPLB_Address)
 112          {
 113   1          IFD = IAPLB_Address;
 114   1          IFMT = 0x04;
 115   1              ISPCR = 0x80 ;                              //Enable IAP to change flash
 116   1          DoISP();
 117   1      }
C51 COMPILER V9.01   MPC_IAP                                                               01/15/2014 14:05:48 PAGE 3   

 118          #endif
 119          ///////////////////////////////////////////////////
 120          //
 121          //      Function:Erase_IAP()
 122          //  Erase One page (512 bytes)
 123          //
 124          ///////////////////////////////////////////////////
 125          void Erase_IAP(unsigned int IAP_Address)
 126          {
 127   1              IFADRH = IAP_Address >> 8;                  //IAP Flash Address High Byte
 128   1              IFADRL = IAP_Address & 0xFF;                    //IAP Flash Address Low Byte
 129   1              IFMT = 0x03 ;                               //IAP Flash Mode Table (Erase Mode)
 130   1              ISPCR = 0x80 ;                              //Enable IAP to change flash
 131   1          DoISP();
 132   1      }
 133          ///////////////////////////////////////////////////
 134          //
 135          //      Function:Write_IAP()
 136          //  Write to IAP address one byte
 137          //
 138          ///////////////////////////////////////////////////
 139          void Write_IAP(unsigned int IAP_Address, unsigned char Value)
 140          {
 141   1              IFADRH = IAP_Address >> 8;                  //IAP Flash Address High Byte
 142   1              IFADRL = IAP_Address & 0xFF;                    //IAP Flash Address Low Byte
 143   1              IFD = Value ;                               //Flash data buffer
 144   1              IFMT = 0x02 ;                               //IAP Flash Mode Table (Write Mode)
 145   1              ISPCR = 0x80 ;                              //Enable IAP to change flash
 146   1          DoISP();
 147   1      }
 148          ///////////////////////////////////////////////////
 149          //
 150          //      Function:Read_IAP()
 151          //  Read one byte from IAP address
 152          //
 153          ///////////////////////////////////////////////////
 154          unsigned char Read_IAP(unsigned int IAP_Address)
 155          {
 156   1              IFADRH = IAP_Address >> 8;                  //IAP Flash Address High Byte
 157   1              IFADRL = IAP_Address & 0xFF;                    //IAP Flash Address Low Byte
 158   1              IFMT = 0x01 ;                               //IAP Flash Mode Table (Read Mode)
 159   1              ISPCR = 0x80 ;                              //Enable IAP to change flash
 160   1          DoISP();
 161   1          return(IFD);                                //Return Flash data
 162   1      }
 163          ///////////////////////////////////////////////////
 164          //
 165          //      Function:Init_UART()
 166          //  Initial UART at Mode 1 and use Timer1 at mode 2
 167          //  We set buad rete is 9600
 168          //  24MHz / 12 / 16 / 9600 = 13.02
 169          //  TH = 256-13 = 0xf3
 170          //
 171          ///////////////////////////////////////////////////
 172          void Init_Uart(void)
 173          {
 174   1          TMOD=0x20;                                  //Set Timer1 Mode 2
 175   1          SCON=0x50;                                  //Set UART Mode 1
 176   1          PCON=0x80;                                  //Set SMOD = 1
 177   1          TH1=0xf3;                                   //Set UART to operate at buad rate 9600
 178   1          TL1=0xf3;
 179   1          TR1 =1;                                     //Start Timer1
C51 COMPILER V9.01   MPC_IAP                                                               01/15/2014 14:05:48 PAGE 4   

 180   1      }
 181          ///////////////////////////////////////////////////
 182          //
 183          //      Function:OutputHex()
 184          //  Output HEX to Char and a space
 185          //
 186          ///////////////////////////////////////////////////
 187          void OutputHex(unsigned char Uart_Data)
 188          {
 189   1          unsigned char DataH,DataL;
 190   1          DataH = Uart_Data >> 4;
 191   1          DataL = Uart_Data & 0x0f;
 192   1          Output(DataH);
 193   1          Output(DataL);
 194   1          Output(0x20);
 195   1      }
 196          ///////////////////////////////////////////////////
 197          //
 198          //      Function:Output()
 199          //  Output to RS232
 200          //
 201          ///////////////////////////////////////////////////
 202          void Output(unsigned char d)
 203          {
 204   1          if(d>9 & d<16)
 205   1              SBUF = d + 0x37;
 206   1          else if(d<10)
 207   1              SBUF = d + 0x30;
 208   1          else if(d==0xaa)    //NewLine
 209   1              SBUF = 0x0a;
 210   1          else if(d==0xdd)    //Return
 211   1              SBUF = 0x0d;
 212   1          else
 213   1              SBUF = d;
 214   1          while(TI == 0){}    //Write transmitting has been finished
 215   1          TI = 0;
 216   1      }


