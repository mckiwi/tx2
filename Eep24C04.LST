 107          //---------------------------------------------------------------------------------
 108          void iicWriteByte(U8 I2cData)
 109          {
 110   1        U8 Bits;
 111   1        
 112   1        for(Bits = 0; Bits < 8; Bits++)
 113   1        {
 114   2          if(I2cData & 0x80)
 115   2          {
 116   3            SET_IIC_SDA;
 117   3          }
C51 COMPILER V9.60.7.0   EEP24C04                                                          12/24/2025 13:49:45 PAGE 3   

 118   2          else
 119   2          {
 120   3            CLR_IIC_SDA;
 121   3          }
 122   2          SET_IIC_SCL;
 123   2          I2CSS_Wait(5);
 124   2          //*** I2CSS_Wait(2);  //~DA,240813  
 125   2          CLR_IIC_SCL;
 126   2          //*** I2CSS_Wait(2);  //~DA,240813,added!   
 127   2          I2cData <<= 1;
 128   2        }
 129   1      }//End of iicWriteByte(U8 I2cData)
 130          
 131          //---------------------------------------------------------------------------------
 132          //READ Byte
 133          //---------------------------------------------------------------------------------
 134          U8 iicReadByte(void)
 135          {
 136   1        U8  I2cData = 0, Bits;
 137   1        for(Bits = 0; Bits < 8; Bits++)
 138   1        {
 139   2          SET_IIC_SCL;
 140   2          I2cData = I2cData << 1;
 141   2          I2cData = I2cData | ((unsigned char)(IIC_SDA));
 142   2          //*** I2CSS_Wait(2);  //~DA,240813,added!
 143   2          CLR_IIC_SCL;
 144   2          //*** I2CSS_Wait(2);  //~DA,240813,added!   
 145   2        }
 146   1        return I2cData;
 147   1      }//End of U8 iicReadByte(void)
