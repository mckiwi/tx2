 151          //---------------------------------------------------------------------------------
 152          void TDF24c04WriteOneByte(U8 IIC_Address, U8 IIC_Data)
 153          {
 154   1        iicSTART();
 155   1        iicWriteByte(EEPROM_24c04_Write);
 156   1        if(iicCheckAck()) iicWriteByte(IIC_Address);
 157   1        if(iicCheckAck()) iicWriteByte(IIC_Data);
 158   1        if(iicCheckAck()) iicSTOP();
 159   1        T2delay1ms(8);//Write Cycle Time Must > 5ms
 160   1      }//End of TDF24c04WriteOneByte(U8 Device_Address, U8 IIC_Address, U8 IIC_Data)
 161          
 162          //---------------------------------------------------------------------------------
 163          //READ DATA FUNCTION
 164          //---------------------------------------------------------------------------------
 165          U8 TDF24c04ReadOneByte(U8 IIC_Address)
 166          {
 167   1        U8 x_Read_iic_Data;
 168   1        iicSTART();
 169   1        iicWriteByte(EEPROM_24c04_Write);
 170   1        if(iicCheckAck()) iicWriteByte(IIC_Address);
 171   1        if(iicCheckAck()) iicSTART();
 172   1        iicWriteByte(EEPROM_24c04_Read);
 173   1        if(iicCheckAck()) x_Read_iic_Data = iicReadByte();
 174   1        NoAck();
 175   1        iicSTOP();
 176   1        return x_Read_iic_Data;
 177   1      //  T2delay1ms(8);//Write Cycle Time > 5ms
 178   1      }//End of TDF24c04ReadOneByte
