 119          //---------------------------------------------------------------------------------
 120          //Write Byte
 121          //---------------------------------------------------------------------------------
 122          void ioWriteByte(U8 I2cData)
 123          {
 124   1        U8 Bits;
 125   1        
 126   1        for(Bits = 0; Bits < 8; Bits++)
 127   1        {
 128   2          if(I2cData & 0x80)
 129   2          {
 130   3            SET_IO_SDA;
 131   3          }
 132   2          else
 133   2          {
 134   3            CLR_IO_SDA;
 135   3          }
 136   2          SET_IO_SCL;
 137   2          ioCSS_Wait(2);
 138   2          CLR_IO_SCL;
 139   2          ioCSS_Wait(2);    
 140   2          I2cData <<= 1;
 141   2        }
 142   1      }//End of ioWriteByte(U8 I2cData)
