 149          //---------------------------------------------------------------------------------
 150          //Write all three Ports
 151          //---------------------------------------------------------------------------------
 152          void ioWrite3Ports(U8 *I2cDataPorts)
 153          {
 154   1        U8 Bits;
 155   1        U8 index,cc;
 156   1        
 157   1        index = 0;  //3Ports: enforce to 0, no matter what index is come in.
 158   1        cc = 0;
 159   1        for(Bits = 0; Bits < 24; Bits++)
 160   1        {
 161   2          if(*(I2cDataPorts + index) & 0x80)
 162   2          {
 163   3            SET_IO_SDA;
 164   3          }
 165   2          else
 166   2          {
 167   3            CLR_IO_SDA;
 168   3          }
 169   2          SET_IO_SCL;
 170   2          ioCSS_Wait(5);
 171   2          CLR_IO_SCL;
 172   2          *(I2cDataPorts + index) <<= 1;
 173   2          cc++;
 174   2          if (cc >= 8) {
 175   3            ioCheckAck();     //:D,Assert ACK     
 176   3            cc = 0;
 177   3            index ++;     
 178   3          }
 179   2        }
