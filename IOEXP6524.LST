 429          //---------------------------------------------------------------------------------
 430          //READ Byte
 431          //---------------------------------------------------------------------------------
 432          U8 ioReadByte(void)
 433          {
 434            U8  I2cData = 0, Bits;
 435            for(Bits = 0; Bits < 8; Bits++)
 436            {
 437              SET_IO_SCL;
 438              I2cData = I2cData << 1;
