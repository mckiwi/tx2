 622          //~DA,240807,Dennis
 623          //~D, Changed to fit P6524,
 624          //:Dennis, new for expander
 625          //   remap ioEXP due to PCB layout trace changed
 626          //   extends to support multi expICs: via expICNum = 0,1(IC#L, IC#R)
 627          //////////////////////////////////////////////////////////////////////////////////////////////////////
 628          #define regBASE  0x04
 629          //             0     1     2     3     4     5     6     7
 630          //act Pairs: (0,0),(1,0),(1,1),(2,0),(1,2),(3,0),(2,1),(3,0)
 631          const ACTMagic_t actMagic[8] = 
 632          {{0,0}, {1,0}, {1,1}, {2,0}, {1,2}, {3,0}, {2,1}, {3,0}};
 633          
 634          
 635          void PCLK_Action(U8 expICNum)
 636          {
 637   1        U8 iact,index;
 638   1        U8 expIOAddr;
 639   1        U8 IOPORTS_DAT[2][3];   //~DA,240813
 640   1      
 641   1        //~DA,240807, which?
 642   1        if (expICNum > 1)
 643   1          return;       //NA
 644   1        if (expICNum == 0)
 645   1          expIOAddr = IOEXP1_ADDR;
 646   1        else
 647   1          expIOAddr = IOEXP2_ADDR;
 648   1        
 649   1        bXIOLock = High;    //lock  
 650   1        //
 651   1        switch(expICNum)
 652   1        {
 653   2          case 0:
 654   2            IOPORTS_DAT[expICNum][0] = STB_CTL | MUTE_CTL | SPB_CTL | SPA_CTL;  //P0
 655   2            IOPORTS_DAT[expICNum][1] = HICUT_CTL | LOWCUT_CTL | LOUD_CTL | STECHO_CTL | ECHO_CTL | REV_CTL | ANTI_C
             -TL;  //P1
 656   2            IOPORTS_DAT[expICNum][2] = SPA_LED | SPB_LED | STECHO_LED | ECHO_LED | REV_LED | HICUT_LED | LOWCUT_LED
             - | ANTI_LED;  //P2
 657   2            break;
 658   2          case 1:
 659   2            IOPORTS_DAT[expICNum][0] = BT_SPDIF_CTL | DISP_CTL; //P0
 660   2            IOPORTS_DAT[expICNum][1] = STB_LED | WUTA_CTL | CH_SEL | PROT_RST;  //P1
 661   2            IOPORTS_DAT[expICNum][2] = CH_LED | LOUD_LED; //P2
C51 COMPILER V9.60.7.0   TX_2                                                              12/24/2025 13:50:51 PAGE 12  

 662   2            break;
 663   2          default:
 664   2            break;
 665   2        }
 666   1      
 667   1        //~DA,240809, maps changes
 668   1        //-------------------------------------------------------------------
 669   1        iact = 0; //[bbb],~DA,240809, 
 670   1        //P0
 671   1        if (IOPORTS_DAT[expICNum][0] != IOPORTS_DATBK[expICNum][0])
 672   1        {
 673   2          iact += 1;
 674   2          IOPORTS_DATBK[expICNum][0] = IOPORTS_DAT[expICNum][0];
 675   2        } 
 676   1        //P1
 677   1        if (IOPORTS_DAT[expICNum][1] != IOPORTS_DATBK[expICNum][1])
 678   1        {
 679   2          iact += 2;
 680   2          IOPORTS_DATBK[expICNum][1] = IOPORTS_DAT[expICNum][1];
 681   2        }
 682   1        //P2
 683   1        if (IOPORTS_DAT[expICNum][2] != IOPORTS_DATBK[expICNum][2])
 684   1        {
 685   2          iact += 4;
 686   2          IOPORTS_DATBK[expICNum][2] = IOPORTS_DAT[expICNum][2];
 687   2        }
 688   1        //-------------------------------------------------------------------
 689   1        
 690   1        //take Act! depends Jobs to carry
 691   1        //--------------------------------------------------------------------------------- 
 692   1        //~DA,240918, Enhanced
 693   1          //(0,0),(1,0),(1,1),(2,0),(1,2),(3,0),(2,1),(3,0)
 694   1        switch(actMagic[iact].g)
 695   1        {
 696   2          case 0: 
 697   2            break;
 698   2          case 1:
 699   2            index = actMagic[iact].i;
 700   2            ioWriteOnePorts(expIOAddr, regBASE+index, &IOPORTS_DAT[expICNum][0], index);
 701   2            break;
 702   2          case 2:
 703   2            index = actMagic[iact].i;
 704   2            ioWriteTwoPorts(expIOAddr, regBASE+index, &IOPORTS_DAT[expICNum][0], index);    
 705   2            break;
 706   2          case 3:
 707   2            ioWriteThreePorts(expIOAddr, regBASE, &IOPORTS_DAT[expICNum][0]);
 708   2            break;
 709   2          default:
 710   2            break;
 711   2        } 
 712   1        //---------------------------------------------------------------------------------
 713   1        bXIOLock = Low;   //released  
 714   1      
 715   1      }//End of PCLK_Action()
