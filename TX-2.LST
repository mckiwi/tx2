4096          //Migrated
4097          void CT7302_Init(void)
4098          {
4099   1          CT_7302_WriteOneByte(0x11, 0x00);//Crystal free run
4100   1          I2CSS_Wait(5);
4101   1          CT_7302_WriteOneByte(0x13, 0x00);//Output port de-jitter set to normal
4102   1          I2CSS_Wait(5);
4103   1          CT_7302_WriteOneByte(0x14, 0x40);//Fading mode setting
4104   1          I2CSS_Wait(5);
4105   1          CT_7302_WriteOneByte(0x30, 0x23);//0x57);//0x23);//SPDIF CDR Frequency detector
4106   1          I2CSS_Wait(5);
4107   1          CT_7302_WriteOneByte(0x31, 0x19);//0x19);//0x19);//SPDIF CDR phase detector gain
4108   1          I2CSS_Wait(5);
4109   1          CT_7302_WriteOneByte(0x32, 0x1E);//0x3F);//0x1E);//SPDIF CDR_PHASE_VC_GAIN_FINE
4110   1          I2CSS_Wait(5);
4111   1          CT_7302_WriteOneByte(0x39, 0xF3);//In/Out PLL bandwidth
4112   1          I2CSS_Wait(5);
4113   1          CT_7302_WriteOneByte(0x3B, 0xFF);//In/Out PLL offset
4114   1          I2CSS_Wait(5);
4115   1          CT_7302_WriteOneByte(0x40, 0x02);//Input PLL switch to high bandwidth mode
4116   1          I2CSS_Wait(5);
4117   1          CT_7302_WriteOneByte(0x45, 0x00);//Output PLL gain setting to min
4118   1          I2CSS_Wait(5);
4119   1          CT_7302_WriteOneByte(0x47, 0xA4);//Bypass check SPDIF CDR fine lock
4120   1          I2CSS_Wait(5);
4121   1          CT_7302_WriteOneByte(0x4D, 0x37);//SPDIF new coarse offset mode enable
4122   1          I2CSS_Wait(5);
4123   1          CT_7302_WriteOneByte(0x4E, 0x72);//In/Out PLL band width
4124   1          I2CSS_Wait(5);
4125   1          CT_7302_WriteOneByte(0x61, 0x08);//Digital OSC frequency fine tune to 50MHz
4126   1          I2CSS_Wait(5);
4127   1          CT_7302_WriteOneByte(0x62, 0x01);//select to use digital OSC
4128   1          I2CSS_Wait(5);
4129   1          CT_7302_WriteOneByte(0x06, 0xC8);//Enable output mute function
