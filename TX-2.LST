 861          //
 862          //~DA,240808, Dennis
 863          //Common Annode
 864          // rewrite 7 SEG display. Mic,
 865          ///////////////////////////////////////////////////////////
 866          void Mic_Display_7SEG(U8 digit)
 867          {
 868   1        U8 dat,i;
 869   1      
 870   1        if (digit > 10)
 871   1          return;
 872   1      
 873   1        //D
 874   1        dat = SEG_DGDAT[digit]; 
 875   1        //MR
 876   1        SRCLR_DP2 = Low;  //clear shift
 877   1        SRCLR_DP2 = High;
 878   1        //Start
 879   1        SRCLK_DP2 = Low;  //start at L
 880   1        RCLK_DP2 = Low;   //Latch   
 881   1        for (i = 0; i < 8; i++)
 882   1        {
 883   2          SER_DP2 = (dat & 0x01) ? High:Low;
 884   2          SRCLK_DP2 = High;
 885   2          SRCLK_DP2 = Low;
 886   2          dat >>= 1;  //LSB 1st
 887   2        }
 888   1        //
 889   1        //latched out
 890   1        RCLK_DP2 = High;  //Latched
 891   1        RCLK_DP2 = Low; 
 892   1      }
