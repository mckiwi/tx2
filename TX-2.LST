1002          void Mic_Volume_Action(void)
1003          {
1004   1          U8 x_Mic_TempBuffer, Mic_count, Mic_Vol_Value, Mic_Temp_Vol;
1005   1        Mic_count = Mic_Volume_Counter;
1006   1          //x_Mic_TempBuffer = Max_Volume - Mic_count;
1007   1         
1008   1          //--- For Displaying And Performing Value Conversions ---//
1009   1          
1010   1          Mic_Vol_Value = Mic_count;
1011   1          
1012   1          if(Mic_Vol_Value == 0X00)                       //7 Segment Display Volume Value 95 --- 00
1013   1          {
1014   2              Mic_Temp_Vol = 0X00;                                //NJW1159 Execute Volume Value 0dB
1015   2          }
1016   1        else if(Mic_Vol_Value == 0X01)                          //7 Segment Display Volume Value 94 --- 01
1017   1          {
1018   2              Mic_Temp_Vol = 0X01;                                //NJW1159 Execute Volume Value -1dB
1019   2          }
1020   1          else if(Mic_Vol_Value == 0X02)                //7 Segment Display Volume Value 93 --- 02
1021   1          {
1022   2              Mic_Temp_Vol = 0X03;                                //NJW1159 Execute Volume Value -1dB
1023   2          }
1024   1          else if(Mic_Vol_Value == 0X03)                          //7 Segment Display Volume Value 92 --- 03
1025   1          {
1026   2              Mic_Temp_Vol = 0X05;                                //NJW1159 Execute Volume Value -2dB
1027   2          }
1028   1          else if(Mic_Vol_Value == 0X04)              //7 Segment Display Volume Value 91 --- 04
1029   1          {
1030   2              Mic_Temp_Vol = 0X07;                                //NJW1159 Execute Volume Value -2dB
1031   2          }
1032   1        else if(Mic_Vol_Value == 0X05)                  //7 Segment Display Volume Value 90 --- 05
1033   1          {
C51 COMPILER V9.60.7.0   TX_2                                                              12/24/2025 13:50:51 PAGE 18  

1034   2              Mic_Temp_Vol = 0X09;                                //NJW1159 Execute Volume Value -7dB
1035   2          }
1036   1          else if(Mic_Vol_Value == 0X06)                //7 Segment Display Volume Value 89 --- 06
1037   1          {
1038   2              Mic_Temp_Vol = 0X0B;                                //NJW1159 Execute Volume Value -3dB
1039   2          }   
1040   1        else if(Mic_Vol_Value == 0X07)                //7 Segment Display Volume Value 88 --- 07
1041   1          {
1042   2              Mic_Temp_Vol = 0X0D;                                //NJW1159 Execute Volume Value -7dB
1043   2          }
1044   1        else if(Mic_Vol_Value == 0X08)                //7 Segment Display Volume Value 87 --- 08
1045   1          {
1046   2              Mic_Temp_Vol = 0X0F;                                //NJW1159 Execute Volume Value -4dB
1047   2          }
1048   1        else if(Mic_Vol_Value == 0X09)                //7 Segment Display Volume Value 86 --- 09
1049   1          {
1050   2              Mic_Temp_Vol = 0X11;                                //NJW1159 Execute Volume Value -7dB
1051   2          }
1052   1          else if(Mic_Vol_Value == 0X0A)              //7 Segment Display Volume Value 85 --- 10
1053   1          {
1054   2              Mic_Temp_Vol = 0X13;                                //NJW1159 Execute Volume Value -5dB
1055   2          }
1056   1        else if(Mic_Vol_Value == 0X0B)                  //7 Segment Display Volume Value 84 --- 11
1057   1          {
1058   2              Mic_Temp_Vol = 0X15;                                //NJW1159 Execute Volume Value -7dB
1059   2          }
1060   1          else if(Mic_Vol_Value == 0X0C)                //7 Segment Display Volume Value 83 --- 12
1061   1          {
1062   2              Mic_Temp_Vol = 0X17;                                //NJW1159 Execute Volume Value -6dB
1063   2          }
1064   1        else if(Mic_Vol_Value == 0X0D)                //7 Segment Display Volume Value 82 --- 13
