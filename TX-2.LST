 789          #if 0
              //*** (((reserved Original))) --------------------------------------------------------------
              //
              //~DA,240808, Dennis
              // rewrite 7 SEG display. Music,
              ///////////////////////////////////////////////////////////
              void Music_Display_7SEG(U8 digit)
              {
                U8 dat,i;
              
                if (digit > 10)
                  return;
                dat = SEG_DGDAT[digit];
              
                //MR
                SRCLR_DP1 = Low;  //clear shift
                SRCLR_DP1 = High;
              
                //Start
                SRCLK_DP1 = Low;  //start at L  
                for (i = 0; i < 8; i++)
                {
                  SER_DP1 = (dat & 0x80) ? High:Low;
                  SRCLK_DP1 = High;
                  SRCLK_DP1 = Low;    
                  if (i < 7) dat <<= 1; //LSB 1st
              
                }
                //
                //latched out
                RCLK_DP1 = Low; 
                RCLK_DP1 = High;
                RCLK_DP1 = Low; 
              }
              #endif
 824          
 825          
 826          //
 827          //~DA,240808, Dennis
 828          //Common Annode
 829          // rewrite 7 SEG display. Music,
 830          //dat = 0x25; //abged --> 00100101 = 0x25 "2"
 831          ///////////////////////////////////////////////////////////
 832          void Music_Display_7SEG(U8 digit)
 833          {
 834   1        U8 dat,i;
 835   1      
 836   1        if (digit > 10)
 837   1          return;
 838   1        
 839   1        //D  
 840   1        dat = SEG_DGDAT[digit];
 841   1        //MR
 842   1        SRCLR_DP1 = Low;  //clear shift
 843   1        SRCLR_DP1 = High;
 844   1        //Start
 845   1        SRCLK_DP1 = Low;  //start at L  
 846   1        RCLK_DP1 = Low;   //Latch
 847   1        for (i = 0; i < 8; i++)
C51 COMPILER V9.60.7.0   TX_2                                                              12/24/2025 13:50:51 PAGE 15  

 848   1        {
 849   2          //DAT ROLL
 850   2          SER_DP1 = (dat & 0x1) ? High:Low;
 851   2          //CLK
 852   2          SRCLK_DP1 = High;
 853   2          SRCLK_DP1 = Low;        
 854   2          dat >>= 1;  //LSB 1st
 855   2        }
 856   1        //latched out
 857   1        RCLK_DP1 = High;  //Latched
 858   1        RCLK_DP1 = Low; 
 859   1      }
